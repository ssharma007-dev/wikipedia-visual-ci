%%{init: {"flowchart": {"wrappingWidth": 220, "nodeSpacing": 40, "rankSpacing": 55, "curve": "basis"}}}%%
flowchart LR
    N["<b>New</b><br/>👩‍💼 Product manager<br/>creates the ticket"]
    R["<b>Ready</b><br/>🧑‍💼 Team lead / engineering manager<br/>adds details and chooses<br/>who builds it"]
    C{"Who builds it?"}
    D["<b>In Progress</b><br/>👩‍💻 Developer<br/>builds the change and the tests,<br/>opens a pull request,<br/>the AI reviews it"]
    A["<b>In Progress</b><br/>🤖 AI agent<br/>builds, tests, reviews<br/>and fixes its own bugs"]
    V["<b>In Review</b><br/>👤 A person decides<br/>( PDF attached )"]
    K["<b>Done</b><br/>✅ Merged<br/>( PDF attached )"]

    N -->|"team lead / engineering manager<br/>reviews, then changes<br/>the status to Ready"| R
    R --> C
    C -->|"assigns a developer"| D
    C -->|"⚡ Run Agent 1"| A
    D -->|"no bugs · approved"| K
    A -->|"no bugs · approved,<br/>or auto-ai-merge"| K
    D -->|"bugs found"| V
    A -->|"bugs it can't fix ·<br/>unsure · human-review"| V
    V -->|"fix pushed ·<br/>the AI reviews again"| V
    V -->|"approved"| K

    classDef person fill:#FFF4E5,stroke:#E8A33D,color:#3B2A12
    classDef ai fill:#E8F1FF,stroke:#4A7BD0,color:#14284B
    classDef good fill:#DFF3E4,stroke:#2E8B57,color:#123D24,stroke-width:2px
    classDef decide fill:#FBE9E7,stroke:#C8553D,color:#4A1C12,stroke-width:2px
    class N,R,D person
    class A ai
    class K good
    class V decide
